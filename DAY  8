{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		int sum=0;
		for(int i=0;i<n;i++){
		    System.out.print("enter "+i+"elements: ");
		    arr[i]=sc.nextInt();
		    sum+=arr[i];
		}
		System.out.print("sum is : "+sum);
	}
}

