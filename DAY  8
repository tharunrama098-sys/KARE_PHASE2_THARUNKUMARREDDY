/****************
how many even numbers in Array
how many odd values in array
***********************/
import java.util.*;
public class Main
{
	public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        int evecount=0,oddcount=0;
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
            if(arr[i]%2==0){
                evecount++;
            }else{
                oddcount++;
            }
        }
        System.out.print("even count "+evecount+"\n"+"odd count : "+oddcount);
	}
}

